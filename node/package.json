{
  "name": "judt-node-template",
  "version": "0.1.0",
  "description": "The base Node.js + Express + React (SSR) + Vite + Tailwind + shadcn template for Judt Apps",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development PORT=3551 node server/index.js",
    "build": "vite build && BUILD_SSR=true vite build && pm2 restart all",
    "dev:server": "npm run build && npm run dev",
    "start": "NODE_ENV=production PORT=3552 node server/index.js"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "express": "^4.19.2",
    "lucide-react": "^0.540.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^6.26.2",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.45",
    "tailwindcss": "^4.1.12",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.3.7",
    "vite": "npm:rolldown-vite@latest"
  },
  "author": "",
  "license": "MIT"
}
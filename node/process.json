{
  "apps": [
    {
      "name": "app-dev-server",
      "script": "npm",
      "args": "run dev",
      "log_file": "./.logs/app.log",
      "time": true,
      "max_memory_restart": "512M",
      "env": {
        "NODE_ENV": "development",
        "PORT": 3551
      },
      "env_production": {
        "NODE_ENV": "production",
        "PORT": 3552
      }
    }
  ]
}
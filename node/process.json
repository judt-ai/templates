{
  "apps": [
    {
      "name": "app-dev-server",
      "script": "npm",
      "args": "run dev:server",
      "log_file": "./.logs/app.log",
      "time": true,
      "watch": true,
      "ignore_watch": [
        "./dist",
        "./.logs",
        "./node_modules",
        "./.pm2"
      ],
      "env": {
        "NODE_ENV": "development",
        "PORT": 3551
      },
      "env_production": {
        "NODE_ENV": "production",
        "PORT": 3552
      }
    }
  ]
}
{
    "compilerOptions": {
        "target": "ESNext",
        "composite": true,
        "skipLibCheck": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowSyntheticDefaultImports": true,
        "strict": true,
        "emitDeclarationOnly": true,
        "esModuleInterop": true
    },
    "include": [
        "vite.config.ts",
        "server"
    ]
}